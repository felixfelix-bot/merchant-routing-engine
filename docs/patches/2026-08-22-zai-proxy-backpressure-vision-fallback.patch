+def _routstrd_balance_snapshot() -> dict:
+    """routstrd (local daemon) wallet balance as a quota-style entry.
+
+    B1 (2026-08-21): the daemon exposes GET /balance (sats). We convert to
+    the used_pct/remaining shape the failover gate understands, FAIL-CLOSED:
+    any error/unknown → exhausted (empty Cashu wallet must never receive
+    traffic; see _routstr_quota_snapshot rationale). Sats→USD not needed —
+    the gate only cares about exhaustion. 5-min cache. Never raises.
+    """
+    now = time.time()
+    if now - _routstrd_bal_cache["ts"] < 300 and _routstrd_bal_cache["entry"]:
+        return dict(_routstrd_bal_cache["entry"])
+    entry = {"used_pct": 100.0, "remaining": 0.0}
+    try:
+        base = _EXTERNAL_KEYS.get("routstrd_base", "http://localhost:8008")
+        req = urllib.request.Request(base.rstrip("/") + "/balance", method="GET")
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            data = json.loads(resp.read())
+        out = data.get("output", data) or {}
+        # 2026-08-22 fix: routstrd /balance returns
+        # {"balances": {mint_url: sats}} — there is no "total" field, so the
+        # old parser always fail-closed and routstrd was never a candidate.
+        # Sum NETWORK-spendable sats only (orangesync is testnut ecash that
+        # network nodes cannot redeem).
+        balances = out.get("balances") or {}
+        total = float(sum(
+            v for m, v in balances.items()
+            if isinstance(v, (int, float)) and "orangesync" not in str(m)
+        )) or 0.0
+        if total > 0:
+            entry = {"used_pct": 0.0, "remaining": total, "balance_sats": total}
+    except Exception:
+        pass
+    _routstrd_bal_cache["entry"] = entry
+    _routstrd_bal_cache["ts"] = now
+    return dict(entry)
+
