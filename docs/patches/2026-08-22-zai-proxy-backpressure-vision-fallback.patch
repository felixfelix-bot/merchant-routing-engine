+def _is_timeout_error(e: BaseException) -> bool:
+    """True if *e* is a timeout-class failure (not an HTTP status error).
+
+    Covers socket.timeout/TimeoutError, urllib.error.URLError whose reason
+    is a timeout, and http.client socket-level timeouts. HTTPError is never
+    a timeout (it carries a real status code).
+    """
+    if isinstance(e, urllib.error.HTTPError):
+        return False
+    if isinstance(e, (TimeoutError, socket_timeout_cls)):
+        return True
+    if isinstance(e, urllib.error.URLError):
+        reason = getattr(e, "reason", None)
+        if isinstance(reason, (TimeoutError, socket_timeout_cls)):
+            return True
+        if isinstance(reason, OSError) and "timed out" in str(reason).lower():
+            return True
+    return "timed out" in str(e).lower() or "timeout" in str(e).lower()
+
