+def _hold_for_zai_recovery(max_wait: float = 25.0) -> bool:
+    """Backpressure hold-queue (2026-08-22): when every z.ai key is in a
+    backoff window whose soonest expiry is <= max_wait seconds away, sleep
+    until just past it and re-check. Returns True when a key became healthy
+    (caller should re-run best_key()); False when there is nothing worth
+    waiting for (a key already healthy, nothing in backoff, or recovery too
+    far away). Never raises. Logs a key_decisions row so hold frequency is
+    observable in the efficiency monitor."""
+    try:
+        names = list(KEYS.keys()) if isinstance(KEYS, dict) else list(KEYS)
+        if any(_is_key_healthy(n) for n in names):
+            return False
+        now = time.time()
+        soonest = None
+        for n in names:
+            h = _zai_key_health.get(n) or {}
+            ra = float(h.get("retry_after") or 0)
+            if ra > now and (soonest is None or ra < soonest):
+                soonest = ra
+        if soonest is None:
+            return False
+        wait = soonest - now
+        if wait <= 0 or wait > max_wait:
+            return False
+        time.sleep(min(wait + 0.25, max_wait))
+        healthy = any(_is_key_healthy(n) for n in names)
+        _log_key_decision(chosen_key=None,
+                          reason=f"hold_queue_waited_{wait:.1f}s_ok_{int(healthy)}")
+        return healthy
+    except Exception:
+        return False
